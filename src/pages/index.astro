---
// v1: the showreel version (chips over the hero, thumbnails, bottom nav pill,
// studio dashboard, cursor label).
import Base from '../layouts/Base.astro';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Showreel from '../components/Showreel.astro';
import Approach from '../components/Approach.astro';
import Work from '../components/Work.astro';
import Expertises from '../components/Expertises.astro';
import StratAI from '../components/StratAI.astro';
import Connect from '../components/Connect.astro';
import NavPill from '../components/NavPill.astro';
import Dashboard from '../components/Dashboard.astro';
import ReelModal from '../components/ReelModal.astro';
import '../styles/v1.css';
---

<Base>
  <Loader />
  <Header />
  <main>
    <Showreel />
    <Approach />
    <Work />
    <Expertises />
    <StratAI />
  </main>
  <Connect />
  <NavPill />
  <Dashboard />
  <ReelModal />
  <div class="cursor-label" aria-hidden="true">
    <p class="cursor-label__name"></p>
    <p class="cursor-label__line"></p>
  </div>
</Base>

<script>
  import '../scripts/main.ts';
</script>
