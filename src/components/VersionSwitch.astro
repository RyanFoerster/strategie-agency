---
// Demo bar: the audit, the prototype versions, and the transition choice.
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = ['audit', 'v4', 'v3', 'v2'].find((id) => path.startsWith(`/${id}`)) ?? 'v1';
const versions = [
  { id: 'v1', href: '/', label: 'v1 showreel' },
  { id: 'v2', href: '/v2', label: 'v2 dashboard' },
  { id: 'v3', href: '/v3', label: 'v3 connect' },
  { id: 'v4', href: '/v4', label: 'v4 stratai' },
];
const isAudit = current === 'audit';
---

<nav class="vswitch" aria-label="prototype versions">
  <a href="/audit" class:list={{ 'is-active': isAudit }} aria-current={isAudit ? 'page' : undefined}>audit</a>
  <hr />
  {
    versions.map((v) => (
      <a href={v.href} class:list={{ 'is-active': v.id === current }} aria-current={v.id === current ? 'page' : undefined}>
        {v.label}
      </a>
    ))
  }
  {
    // the transition choice only means something on the prototypes
    !isAudit && (
      <>
        <hr />
        <span class="vswitch__label">transition</span>
        <button type="button" class="is-active" data-tmode="wave" aria-pressed="true">wave</button>
        <button type="button" data-tmode="fade" aria-pressed="false">minimal</button>
      </>
    )
  }
</nav>
