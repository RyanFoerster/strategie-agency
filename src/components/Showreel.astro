---
import { byslug, media } from '../data/site';

const reelCases = ['balade', 'mcdonalds', 'ferrero-rocher', 'nutella', 'promagnor', 'herta'].map(byslug);

const slides = [
  {
    name: 'showreel',
    title: ['we connect,', 'you grow'],
    accent: true,
    tags: ['showreel 2026', 'branding', 'communication'],
    href: '#about',
    label: 'showreel · scroll to explore',
    thumb: null,
  },
  ...reelCases.map((c) => ({
    name: c.name,
    title: [c.name, c.line],
    accent: false,
    tags: c.tags,
    href: c.href,
    label: `${c.name} · see the story`,
    thumb: c.cover,
  })),
];

const total = String(slides.length).padStart(2, '0');
const first = slides[0];
---

<section class="reel" id="top" data-section="showreel">
  <div class="reel__frame">
    <canvas class="reel__canvas" aria-hidden="true"></canvas>
    <div class="reel__shade" aria-hidden="true"></div>

    <div class="reel__chips">
      <span class="chip">strategie<sup>®</sup></span>
      <button class="chip chip--btn" type="button" data-reel-play aria-label="play the showreel">
        <i class="chip__play" aria-hidden="true"></i><span data-roll>play reel</span>
      </button>
      <a class="chip chip--btn chip--link" data-reel-link href={first.href}>
        <span aria-hidden="true">↗</span><span data-roll>see the story</span>
      </a>
      <span class="chip tnum" data-reel-duration>--:--</span>
    </div>

    <div class="reel__bottom">
      <div class="reel__meta">
        <div class="reel__count small tnum">
          <span class="reel__idx" data-reel-idx><span>01</span></span><span class="mute-w">/ {total}</span>
        </div>
        <h1 class="reel__title" data-reel-title>
          <span class="rt-group">
            <span class="rt-line"><span>{first.title[0]}</span></span>
            <span class="rt-line rt-line--2 rt-line--grad"><span>{first.title[1]}</span></span>
          </span>
        </h1>
        <div class="reel__tags" data-reel-tags>
          {first.tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      </div>

      <div class="reel__thumbs" aria-label="jump to a case">
        <button class="thumb is-active" type="button" data-thumb="0" aria-label="showreel">
          <video data-reel-src="0" src={media.wave} muted loop playsinline autoplay preload="auto"></video>
          <i class="thumb__bar" aria-hidden="true"></i>
        </button>
        {
          reelCases.map((c, i) => (
            <button class="thumb" type="button" data-thumb={i + 1} aria-label={`${c.name}, ${c.line}`}>
              <img data-reel-src={i + 1} src={c.cover} alt="" decoding="async" />
              <i class="thumb__bar" aria-hidden="true" />
            </button>
          ))
        }
      </div>
    </div>
  </div>
  <script type="application/json" id="reel-data" set:html={JSON.stringify(slides)} />
</section>
