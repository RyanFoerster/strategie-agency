---
import { byslug, featuredV2, media } from '../../data/site';
import PlayRing from '../PlayRing.astro';
import ReelThread from '../ReelThread.astro';

const reelCases = featuredV2.map(byslug);
const slides = [
  {
    name: 'showreel',
    title: ['we connect,', 'you grow'],
    accent: true,
    tags: ['showreel 2026', 'branding', 'communication'],
    href: '#about',
  },
  ...reelCases.map((c) => ({ name: c.name, title: [c.name, c.line], accent: false, tags: c.tags, href: c.href })),
];
const total = String(slides.length).padStart(2, '0');
const first = slides[0];
---

<section class="d-reel" id="top" aria-label="showreel">
  <canvas class="d-reel__canvas" aria-hidden="true"></canvas>
  <div class="reel__shade" aria-hidden="true"></div>

  <PlayRing />

  <div class="reel__bottom">
    <div class="reel__meta">
      <div class="reel__count small tnum">
        <span class="reel__idx" data-reel-idx><span>01</span></span><span class="mute-w">/ {total}</span>
      </div>
      <h1 class="reel__title" data-reel-title>
        <span class="rt-group">
          <span class="rt-line"><span>{first.title[0]}</span></span>
          <span class="rt-line rt-line--2 rt-line--grad"><span>{first.title[1]}</span></span>
        </span>
      </h1>
      <div class="reel__tags" data-reel-tags>
        {first.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      <a class="reel__story small" data-reel-link href={first.href}><span class="u">see the story</span> ↗</a>
    </div>
    <button class="chip chip--btn d-auto" type="button" data-autoplay aria-pressed="true" aria-label="pause the autoplay">
      <span class="d-auto__icon" aria-hidden="true"></span>
    </button>
  </div>

  <ReelThread names={slides.map((s) => s.name)} />

  <div class="d-reel__sources" aria-hidden="true">
    <video data-reel-src="0" src={media.wave} muted loop playsinline autoplay preload="auto"></video>
    {reelCases.map((c, i) => <img data-reel-src={i + 1} src={c.cover} alt="" decoding="async" />)}
  </div>
  <script type="application/json" id="reel-data" set:html={JSON.stringify(slides)} />
</section>
